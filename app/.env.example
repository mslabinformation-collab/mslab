# Server configuration. src/server/env.ts reads these from process.env. Placeholders only: no real address, key or
# password ever goes into the repository (tests/unit/test-addresses.test.ts rejects real addresses).
#
# Production (Vercel): these are the project's Environment Variables, entered in the Vercel dashboard or with
# `vercel env add`, never in a file of the repository. The six required ones below must be set: without one every
# request answers 500 and the error names the variable (never its value). The optional ones at the end switch features on.
#
# Local `next dev`: nothing has to be set. Without a value, the database is the local one below (the docker Postgres on
# port 5432), SITE_URL and MAIL_FROM are the public values below, and ADMIN_EMAILS, ADMIN_NAMES and MARIA_EMAIL are
# empty: nobody can sign in, nothing is sent. To sign in with your own address, copy this file to .env.local (git-ignored;
# Next.js reads it) and change the values.
#
# The e2e tests (playwright.config.ts) hand the six required values of THIS file to the server they start (`next dev`, or
# the production build with E2E_PROD_BUILD=1; they win over a .env.local) and sign in as the first ADMIN_EMAILS address.
# They refuse to run when a database setting anywhere points at a machine other than this one (tests/e2e/local-db.ts),
# and when RESEND_API_KEY, TELEGRAM_BOT_TOKEN or an R2 variable is set. The database tools (npm run db:migrate, db:seed)
# take DATABASE_URL from the shell.

# --- required in production ---

# the Postgres connection URL: the local database here; in production Railway's TCP proxy URL (a password inside), with
# ?sslmode=require at the end: it is reached over the internet, and postgres.js encrypts only when the URL says so
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mslab
# the site's own address: links that leave the site (e-mails, link previews)
SITE_URL=https://mslab.ee
# the sign-in allow-list, comma-separated
ADMIN_EMAILS=admin@example.test,second.admin@example.test
# the greeting name of each admin: <address>=<name>, comma-separated
ADMIN_NAMES=admin@example.test=Dim,second.admin@example.test=Maria
# where form notifications go (never sent locally without RESEND_API_KEY)
MARIA_EMAIL=maria@example.test
# the From header of outgoing mail
MAIL_FROM=MS LAB <info@send.mslab.ee>

# --- optional: leave them out locally ---

# e-mail through Resend; without it nothing is sent and a console note says so
# RESEND_API_KEY=
# the newsletter's contacts, segments and broadcasts (newsletter campaigns): a full-access key of the same Resend account; without it
# RESEND_API_KEY is used, and without either the newsletter is not synced or sent ("not set up")
# RESEND_MARKETING_KEY=
# the signing secret of the Resend webhook to /api/resend/webhook (contact.updated, suppression.added, suppression.removed); without it
# every event is refused
# RESEND_WEBHOOK_SECRET=
# Telegram pings to Maria; TELEGRAM_CHAT_ID overrides the chat id kept in the database (kv_entries key tg:chat)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# the access key of the review comment list (/guide/tagasiside/); `next dev` accepts a local key when it is not set
# ADMIN_KEY=
# the image bucket on Cloudflare R2, through its S3 API (an R2 API token's access key; all four, or none). With none set,
# `next dev` keeps uploaded images in the folder app/.media-local (git-ignored); in production no R2 means no uploads
# and /media answers 404
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# "1": without R2, a production build keeps uploaded images in app/.media-local as `next dev` does. Only for
# `next build && next start` on this machine (the e2e run sets it); never on Vercel, whose disk is not kept
# MEDIA_LOCAL=
# the daily cron (vercel.json: GET /api/cron/sweep deletes the expired kv_entries rows, the forms' rate limit counters
# among them). Vercel sends `Authorization: Bearer <CRON_SECRET>` when the project has this variable; without it the
# cron is refused (401). A long random string, in the Vercel project only
# CRON_SECRET=
# Bunny Stream, the lesson videos (docs/deploy.md section 10): the video library's id (not a secret), its API key and its embed
# view token authentication key (the library's Security settings; not the CDN token authentication key). All three or none:
# without them the admin's video field says "Video seadistamata" and students see "Video lisandub peagi". The two keys are
# sensitive: Vercel only, never in a file
# BUNNY_LIBRARY_ID=
# BUNNY_API_KEY=
# BUNNY_TOKEN_KEY=
# a long random string; the webhook URL in Bunny is https://<site>/api/bunny/webhook?secret=<it>
# BUNNY_WEBHOOK_SECRET=
# the e2e run's fake Bunny server (tests/e2e/fake-bunny.ts sets it for the server it starts); never on Vercel, where it is ignored
# BUNNY_FAKE_URL=
# the coming-soon gate (src/lib/site-gate.ts): "1" and visitors see only the coming-soon page, whatever the address; signed-in
# admins (the preview cookie mslab_preview) see the whole site. Unset here, so `next dev` and the e2e run show the site; the
# launch removes it from the Vercel project (and redeploys)
# SITE_GATE=
# the key of the admins' preview cookie: a long random string of at least 32 characters (a shorter one counts as not set), in
# the Vercel project only. With SITE_GATE on and this unset, nobody gets past the coming-soon page except to /admin; changing
# it (and redeploying) ends every admin's preview pass: do so when an admin leaves
# PREVIEW_SECRET=
# Online payments (phase 2b, docs/deploy.md section 11): Maria's Montonio store. Both keys or none: without them there are no online
# payments and the site behaves as before. MONTONIO_ENV: only the exact "live" is Montonio's production, anything else its sandbox.
# For trying payments under `next dev`, the SANDBOX keys go in .env.local (git-ignored); the e2e run overrides them with its fake's.
# The secret key is sensitive: Vercel or .env.local only, never in a tracked file
# MONTONIO_ENV=
# MONTONIO_ACCESS_KEY=
# MONTONIO_SECRET_KEY=
# what the payments' Montonio references start with (<prefix><payment id>): 2 to 16 capitals, digits or hyphens, not ending in a digit;
# anything else turns payments off. Unset: MSLAB-M on Vercel's production only, MSLAB-P on a preview, MSLAB-L anywhere else (this machine,
# the e2e run). Leave it unset; never MSLAB-M outside production: production runs on the sandbox store too until the launch, and a local
# MSLAB-M<id> would replace production's order of that reference there, its webhook reaching production (docs/deploy.md section 11)
# MONTONIO_REFERENCE_PREFIX=
# the e2e run's fake Montonio (tests/local-secrets.ts and tests/e2e/prod-build.ts set them for the servers it starts): "mock" points the
# payments at MONTONIO_FAKE_URL (plain http on localhost, 127.0.0.1 or [::1] only); refused on Vercel, and in a production build without
# PAYMENT_MOCK_IN_PRODUCTION=1. Never on Vercel
# PAYMENT_PROVIDER=
# MONTONIO_FAKE_URL=
# PAYMENT_MOCK_IN_PRODUCTION=
